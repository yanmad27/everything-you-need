# Everything You Need - Environment Variables
# Copy this file to .env and modify according to your needs

# Application Configuration
APP_NAME="Everything You Need"
APP_ENVIRONMENT="production"
APP_LOG_LEVEL="info"

# Price Sources Configuration
PRICE_SOURCES_DOJI_ENABLED="true"
# Optional override; defaults to https://banggia.doji.vn/api/TablePrice/GetTablePrice
PRICE_SOURCES_DOJI_API_URL=""

PRICE_SOURCES_BTMC_ENABLED="true"
PRICE_SOURCES_BTMC_API_URL="http://api.btmc.vn/api/BTMCAPI/getpricebtmc?key=YOUR_BTMC_API_KEY"

# Telegram Bot Configuration
TELEGRAM_ENABLED="true"
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
TELEGRAM_CHANNEL_ID="YOUR_CHANNEL_ID_HERE"

# Zalo Bot Configuration (optional; see docs/zalo-service.md)
ZALO_ENABLED="false"
ZALO_BOT_TOKEN=""
ZALO_WEBHOOK_SECRET=""
CHAT_FETCH_ALLOW_DOMAINS="" # comma-separated domains the model may fetch on its own (empty = built-in list)
ZALO_PRIVATE_TOOL_CHATS="" # comma-separated chat ids allowed to use the due_dates tool

# OpenAI-compatible LLM for the Zalo bot only (optional; Telegram stays on Claude)
LLM_OPENAI_BASE_URL=""
LLM_OPENAI_API_KEY=""
LLM_OPENAI_MODEL="gpt-6-sol"

# Example values:
# TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
# TELEGRAM_CHANNEL_ID="@yourchannel" or "-1001234567890"
# Zalo conversation store for the admin UI (optional)
CONVO_ENABLED="true"
CONVO_DB_PATH="data/convo.db"
CONVO_RETENTION_DAYS="90"
CONVO_PRICE_PROMPT_PER_1K="0"
CONVO_PRICE_COMPLETION_PER_1K="0"
# Per-model prices per 1M tokens, "model:prompt:completion,..." (no defaults; unpriced models show "price not configured")
CONVO_PRICES=""
CONVO_CURRENCY="USD"

# Admin UI (optional): username + a password hash are required to enable /admin.
# Recommended on Dokploy/compose: ADMIN_PASSWORD_HASH_B64 (base64 of the bcrypt hash, printed by
# `go run ./cmd/adminhash`). It contains no `$`, so compose interpolation cannot mangle it, and it
# takes precedence over ADMIN_PASSWORD_HASH.
# Alternative: ADMIN_PASSWORD_HASH (raw bcrypt, no quotes in Dokploy UIs); every `$` must be written `$$`.
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH_B64=""
ADMIN_PASSWORD_HASH=''
ADMIN_SESSION_SECRET=""
# Set to "true" for one start to discard a password changed in the UI (env hash applies again), then unset.
ADMIN_PASSWORD_RESET=""
