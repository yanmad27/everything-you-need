# Everything You Need - Environment Variables
# Copy this file to .env and modify according to your needs

# Application Configuration
APP_NAME="Everything You Need"
APP_ENVIRONMENT="production"
APP_LOG_LEVEL="info"

# Price Sources Configuration
PRICE_SOURCES_DOJI_ENABLED="true"
# Optional override; defaults to https://banggia.doji.vn/api/TablePrice/GetTablePrice
PRICE_SOURCES_DOJI_API_URL=""

PRICE_SOURCES_BTMC_ENABLED="true"
PRICE_SOURCES_BTMC_API_URL="http://api.btmc.vn/api/BTMCAPI/getpricebtmc?key=YOUR_BTMC_API_KEY"

# Telegram Bot Configuration
TELEGRAM_ENABLED="true"
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
TELEGRAM_CHANNEL_ID="YOUR_CHANNEL_ID_HERE"

# Example values:
# TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
# TELEGRAM_CHANNEL_ID="@yourchannel" or "-1001234567890"